{
  "name": "scoremap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Your sheet music, mapped out.",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/juangcarmona/scoremap.git"
  },
  "devDependencies": {
    "@arcshape/cli": "0.4.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@fission-ai/openspec": "1.15.0",
    "@juangcarmona/lighthouse": "0.13.19",
    "@playwright/test": "1.65.1",
    "@prodshape/cli": "0.26.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.1",
    "markdownlint-cli2": "0.24.1",
    "playwright-core": "1.65.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.2",
    "@tonaljs/chord-detect": "4.9.4",
    "@tonaljs/chord-type": "5.2.2",
    "@tonaljs/note": "4.12.4",
    "idb": "8.0.4",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "picomatch": "npm:@ryotsu/picomatch@4.0.7-a",
    "@mermaid-js/mermaid-cli": {
      "katex": "0.18.10"
    },
    "micromark-extension-math": {
      "katex": "0.18.10"
    }
  },
  "scripts": {
    "verify:product": "prodshape --serialization-version v1alpha2 validate",
    "verify:citations": "prodshape citations verify --provider openspec --format json && prodshape citations verify docs/architecture --format json",
    "verify:architecture": "arcshape validate --docs docs/architecture --links --citations",
    "verify:baseline": "lighthouse verify && node scripts/lighthouse-guard.mjs verify",
    "verify:specs": "openspec validate --all --strict --no-interactive",
    "verify": "npm run verify:product && npm run verify:citations && npm run verify:architecture && npm run verify:baseline && npm run verify:specs && npm run verify:music-catalogue && npm run verify:backend && npm run verify:private-api-contract && npm run verify:deployment && npm run verify:security && npm run verify:frontend-boundaries && npm run verify:app",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.config.{ts,js}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.config.{ts,js}\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:app": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "evidence:record": "node scripts/record-verification.mjs && prodshape evidence verify docs/evidence/mvp/verification-evidence.json --format json",
    "verify:delivery": "node scripts/verify-delivery.mjs",
    "build:private": "VITE_SCOREMAP_PRIVATE=1 npm run build",
    "dev:private": "node scripts/dev-private.mjs",
    "verify:backend": "npm run verify:dotnet",
    "test:connected": "playwright test --config=playwright.connected.config.ts",
    "verify:security": "node --test tests/security/*.test.mjs && node scripts/verify-security.mjs",
    "verify:dotnet": "node node_modules/@juangcarmona/lighthouse/src/verify-dotnet.mjs && node scripts/verify-backend-boundaries.mjs && node --test tests/architecture/analyzer-visibility.test.mjs && node tests/architecture/verify-module-analyzer-severity.mjs && node --test tests/architecture/analyzer-severity.test.mjs",
    "verify:frontend-boundaries": "node scripts/verify-frontend-boundaries.mjs",
    "build:container": "node scripts/build-container.mjs",
    "verify:music-catalogue": "node scripts/harmony-catalogue.mjs",
    "verify:deployment": "node scripts/publish-production.mjs --verify",
    "publish:production": "node scripts/publish-production.mjs",
    "test:deployment": "python3 scripts/qualify-production.py",
    "test:session-vault": "python3 scripts/qualify-session-vault.py",
    "verify:connected": "node scripts/verify-connected.mjs",
    "verify:private-api-contract": "node scripts/verify-private-api-contract.mjs"
  }
}
